generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  username      String
  avatarUrl     String?
  bio           String?    @db.Text
  dartsCareer   String?
  highestRating String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  favorites     Favorite[]
  settings      Setting[]

  @@map("user")
}

model Barrel {
  id          String    @id @default(cuid())
  name        String
  maker       String
  price       Int
  imageUrl    String
  hiveUrl     String?
  weight      Float
  totalLength Float
  maxDiameter Float
  material    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  settings    Setting[]

  @@map("barrel")
}

model Shaft {
  id          String    @id @default(cuid())
  name        String
  maker       String
  price       Int
  imageUrl    String
  hiveUrl     String?
  shaftLength String
  shaftShape  String
  material    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  settings    Setting[]

  @@map("shaft")
}

model Flight {
  id            String    @id @default(cuid())
  name          String
  maker         String
  price         Int
  imageUrl      String
  hiveUrl       String?
  includesShaft Boolean   @default(false)
  flightShape   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  settings      Setting[]

  @@map("flight")
}

model Tip {
  id        String    @id @default(cuid())
  name      String
  maker     String
  price     Int
  imageUrl  String
  hiveUrl   String?
  tipType   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settings  Setting[]

  @@map("tip")
}

model Setting {
  id               String            @id @default(cuid())
  userId           String
  title            String
  description      String            @db.Text
  imageUrl         String
  recommendedLevel RecommendedLevel?
  tag              Tag
  barrelId         String
  shaftId          String?
  flightId         String
  tipId            String
  totalWeight      Float
  totalPrice       Int
  favoriteCount    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  favorites        Favorite[]
  barrel           Barrel            @relation(fields: [barrelId], references: [id])
  flight           Flight            @relation(fields: [flightId], references: [id])
  shaft            Shaft?            @relation(fields: [shaftId], references: [id])
  tip              Tip               @relation(fields: [tipId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([barrelId])
  @@index([shaftId])
  @@index([flightId])
  @@index([tipId])
  @@map("setting")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  settingId String
  createdAt DateTime @default(now())
  setting   Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, settingId])
  @@index([settingId])
  @@map("favorite")
}

enum RecommendedLevel {
  BEGINNER
  BEGINNER_INTERMEDIATE
  INTERMEDIATE
  INTERMEDIATE_ADVANCED
  ADVANCED
}

enum Tag {
  STABILITY
  COST_PERFORMANCE
  LIGHTWEIGHT
  FLIGHT_DISTANCE
  STRAIGHT
  BALANCE
}
