generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  emailVerified          DateTime?
  passwordHash           String
  username               String
  avatarUrl              String?
  bio                    String?                 @db.Text
  dartsCareer            String?
  highestRating          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  favorites              Favorite[]
  settings               Setting[]
  emailVerificationToken EmailVerificationToken?

  @@map("user")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  issuedAt  DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_token")
}

model Barrel {
  id          String    @id @default(cuid())
  name        String
  maker       String
  price       Int
  imageUrl    String
  hiveUrl     String?
  weight      Float
  totalLength Float
  maxDiameter Float
  material    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  settings    Setting[]

  @@map("barrel")
}

model Shaft {
  id           String       @id @default(cuid())
  name         String
  maker        String
  price        Int
  imageUrl     String
  hiveUrl      String?
  shaftLength  String
  shaftShape   String
  isSpin       Boolean      @default(false)
  material     String
  flightSystem FlightSystem
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  settings     Setting[]

  @@map("shaft")
}

model Flight {
  id           String        @id @default(cuid())
  name         String
  maker        String
  price        Int
  imageUrl     String
  hiveUrl      String?
  flightType   FlightType    @default(MOLDED)
  shaftLength  String?
  flightShape  String
  // シャフト一体型はシャフト部分ごと交換するため規格を持たない(null)。成型は必須
  flightSystem FlightSystem?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  settings     Setting[]

  @@map("flight")
}

model Tip {
  id         String        @id @default(cuid())
  name       String
  maker      String
  price      Int
  imageUrl   String
  hiveUrl    String?
  threadSize TipThreadSize @default(TWO_BA)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  settings   Setting[]

  @@map("tip")
}

model Setting {
  id               String            @id @default(cuid())
  userId           String
  title            String
  description      String            @db.Text
  imageUrl         String
  recommendedLevel RecommendedLevel?
  tag              Tag
  barrelId         String
  shaftId          String?
  flightId         String
  tipId            String
  totalWeight      Float
  totalPrice       Int
  favoriteCount    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  favorites        Favorite[]
  barrel           Barrel            @relation(fields: [barrelId], references: [id])
  flight           Flight            @relation(fields: [flightId], references: [id])
  shaft            Shaft?            @relation(fields: [shaftId], references: [id])
  tip              Tip               @relation(fields: [tipId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([barrelId])
  @@index([shaftId])
  @@index([flightId])
  @@index([tipId])
  @@map("setting")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  settingId String
  createdAt DateTime @default(now())
  setting   Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, settingId])
  @@index([settingId])
  @@map("favorite")
}

enum RecommendedLevel {
  BEGINNER
  BEGINNER_INTERMEDIATE
  INTERMEDIATE
  INTERMEDIATE_ADVANCED
  ADVANCED
}

enum FlightType {
  MOLDED
  SHAFT_INTEGRATED
}

// シャフトとフライトの接続規格。規格が違うと物理的に組み合わせられない
enum FlightSystem {
  UNIVERSAL // 汎用(爪でフライトを挟むタイプ。L-style、TARGETのPRO GRIPなど)
  FIT // フィット(COSMO DARTS)
  CLICK // クリック(Harrows)
  EIGHT // エイト(8FLIGHT)
}

enum TipThreadSize {
  TWO_BA // 2BA(ソフトダーツで一般的な規格)
  NO_5 // No.5
}

enum Tag {
  STABILITY
  COST_PERFORMANCE
  LIGHTWEIGHT
  FLIGHT_DISTANCE
  STRAIGHT
  BALANCE
}
