// ============================================================
// DartSetting - Prisma Schema (MVP版)
// ============================================================
// 命名規則:
//   - モデル名: PascalCase単数形
//   - フィールド名: camelCase
//   - テーブル名(@@map): snake_case複数形 (MySQL慣習に合わせる)
//
// MVPスコープ方針:
//   - 認証はメール+パスワードのみ(OAuthは後回し)
//   - 画像は1商品/1セッティングにつき1枚のみ(複数枚アップロードは後回し)
//   - 評価・レビュー(星評価)機能は無し(後回し)
//   - フォロー機能は無し(後回し)
//   - 検索はキーワード検索のみ(詳細な絞り込みは後回し)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------------------------------
// Enum
// ------------------------------------------------------------

enum RecommendedLevel {
  BEGINNER // 初心者向け
  BEGINNER_INTERMEDIATE // 初心者〜中級者
  INTERMEDIATE // 中級者向け
  INTERMEDIATE_ADVANCED // 中級者〜上級者
  ADVANCED // 上級者向け
}

enum Tag {
  STABILITY // 安定性重視
  COST_PERFORMANCE // コスパ重視
  LIGHTWEIGHT // 軽量
  FLIGHT_DISTANCE // 飛び重視
  STRAIGHT // ストレート
  BALANCE // バランス重視
}

// ------------------------------------------------------------
// User
// ------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String // メール+パスワード認証のみのため必須
  username      String
  avatarUrl     String?
  bio           String?  @db.Text
  dartsCareer   String? // 例: "2年"
  highestRating String? // 例: "Rt. 15.00"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settings  Setting[]
  favorites Favorite[]

  @@map("user")
}

// ------------------------------------------------------------
// Barrel / Shaft / Flight / Tip
// ------------------------------------------------------------
// カテゴリごとに固有項目が異なるため、テーブルを分割している。
// 画像はMVPでは1枚のみのため imageUrl (単一文字列) として保持する。

model Barrel {
  id          String  @id @default(cuid())
  name        String
  maker       String
  price       Int // 税込価格(円)
  imageUrl    String
  hiveUrl     String? // 購入ページURL(商品詳細の購入ボタン用)

  weight      Float // g
  totalLength Float // mm (全長)
  maxDiameter Float // mm (最大径)
  material    String // 例: タングステン95%

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings Setting[]

  @@map("barrel")
}

model Shaft {
  id          String  @id @default(cuid())
  name        String
  maker       String
  price       Int
  imageUrl    String
  hiveUrl     String? // 購入ページURL(商品詳細の購入ボタン用)

  shaftLength String // 例: "260" (LOCK Standardなど)
  shaftShape  String
  material    String // 例: アルミ、カーボン、ポリカーボネート

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings Setting[]

  @@map("shaft")
}

model Flight {
  id          String  @id @default(cuid())
  name        String
  maker       String
  price       Int
  imageUrl    String
  hiveUrl     String? // 購入ページURL(商品詳細の購入ボタン用)

  includesShaft Boolean @default(false) // シャフト一体型商品の場合true(セッティング登録時にシャフト選択を不要にする)
  flightShape   String // 例: スタンダード、シェイプ、ティアドロップ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings Setting[]

  @@map("flight")
}

model Tip {
  id          String  @id @default(cuid())
  name        String
  maker       String
  price       Int
  imageUrl    String
  hiveUrl     String? // 購入ページURL(商品詳細の購入ボタン用)

  tipType String // ソフト / ハードなど

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings Setting[]

  @@map("tip")
}

// ------------------------------------------------------------
// Setting (ユーザーが登録するセッティング)
// ------------------------------------------------------------

model Setting {
  id               String            @id @default(cuid())
  userId           String
  title            String
  description      String            @db.Text // 特徴・使用感
  imageUrl         String // MVPでは1枚のみ
  recommendedLevel RecommendedLevel? // おすすめレベル(単一選択、任意)
  tag              Tag // アピールポイント(単一選択、必須)

  barrelId String
  shaftId  String? // シャフト一体型のフライト(Flight.includesShaft=true)を選んだ場合はnull
  flightId String
  tipId    String

  totalWeight Float // 自動計算(バレルの重量をそのまま使用。ダーツの「重さ」はバレル重量を指すのが慣習のため)
  totalPrice  Int // 自動計算(バレル+シャフト+フライト+チップの合計金額。shaftIdがnullの場合はシャフト分を加算しない)

  favoriteCount Int @default(0) // 非正規化カウント(いいね数表示用)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  barrel Barrel @relation(fields: [barrelId], references: [id])
  shaft  Shaft? @relation(fields: [shaftId], references: [id])
  flight Flight @relation(fields: [flightId], references: [id])
  tip    Tip    @relation(fields: [tipId], references: [id])

  favorites Favorite[]

  @@index([userId])
  @@index([barrelId])
  @@index([shaftId])
  @@index([flightId])
  @@index([tipId])
  @@map("setting")
}

// ------------------------------------------------------------
// Favorite (お気に入り: User - Setting)
// ------------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  settingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  setting Setting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([userId, settingId]) // 同じセッティングへの重複お気に入り防止
  @@index([settingId])
  @@map("favorite")
}
