# このファイルをコピーして .env を作成してください: cp .env.example .env

# --- DB ---
DATABASE_URL="mysql://root:root@localhost:3306/yakurabe"

# --- アプリ ---
# メール内の認証リンク等に使うベースURL(本番: https://yakurabe.com)
APP_URL="http://localhost:3000"

# --- NextAuth ---
# npx auth secret などで生成したランダム文字列
AUTH_SECRET=""

# --- メール送信 ---
# smtp: 開発用(Mailpit) / ses: 本番用(AWS SES)
MAIL_DRIVER="smtp"
MAIL_FROM="no-reply@yakurabe.local"

# MAIL_DRIVER=smtp のとき必須
# docker compose内のappからは "mailpit"、ホストで npm run dev する場合は "localhost"
SMTP_HOST="localhost"
SMTP_PORT="1025"

# MAIL_DRIVER=ses のとき必須
# SES送信専用IAMユーザー(ses:SendEmail のみ許可)のアクセスキーを設定する
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
