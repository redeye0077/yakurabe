# このファイルをコピーして .env を作成してください: cp .env.example .env

# --- DB ---
DATABASE_URL="mysql://root:root@localhost:3306/yakurabe"

# --- アプリ ---
# メール内の認証リンク等に使うベースURL(本番: https://yakurabe.com)
APP_URL="http://localhost:3000"

# --- NextAuth ---
# npx auth secret などで生成したランダム文字列
AUTH_SECRET=""

# --- メール送信 ---
# smtp: 開発用(Mailpit) / ses: 本番用(AWS SES)
MAIL_DRIVER="smtp"
MAIL_FROM="no-reply@yakurabe.local"

# MAIL_DRIVER=smtp のとき必須
# docker compose内のappからは "mailpit"、ホストで npm run dev する場合は "localhost"
SMTP_HOST="localhost"
SMTP_PORT="1025"

# MAIL_DRIVER=ses のとき必須
# SES送信専用IAMユーザー(ses:SendEmail のみ許可)のアクセスキーを設定する
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- 画像ストレージ(S3) ---
# docker compose の app では docker-compose.yml の値(S3Mock 向け)で上書きされる
# 本番: 画像保存専用IAMユーザー(settings/* への s3:PutObject / s3:GetObject / s3:DeleteObject のみ許可)のアクセスキー
# SES 用の AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY とは別に設定する
S3_REGION="ap-northeast-1"
S3_BUCKET="yakurabe-dev"
S3_ACCESS_KEY_ID="dummy"
S3_SECRET_ACCESS_KEY="dummy"
# 画像の表示用 URL の先頭部分(末尾の / は無し)。本番は https://<バケット名>.s3.ap-northeast-1.amazonaws.com
S3_PUBLIC_BASE_URL="http://localhost:9090/yakurabe-dev"
# 開発のみ(S3Mock)。本番は空のままにする
# S3_ENDPOINT: サーバーからの接続先 / S3_PUBLIC_ENDPOINT: ブラウザに渡す署名付き URL の接続先
S3_ENDPOINT="http://localhost:9090"
S3_PUBLIC_ENDPOINT=""
